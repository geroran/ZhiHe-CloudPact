# 校园集市 Agent 服务端配置
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交真实密钥。

APP_NAME=校园集市 Agent
APP_HOST=127.0.0.1
APP_PORT=8011

# OpenAI Chat Completions 兼容模型（真实服务端代理）
# 未配置 OPENAI_API_KEY / OPENAI_MODEL 时，/api/chat 返回 MODEL_NOT_CONFIGURED。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.4
MODEL_TIMEOUT=90
SYSTEM_PROMPT=

# 当前仓库不包含真实集市 API 适配器，也没有可确认的凭据或成功响应。
# 保持 disabled 时，所有集市读取接口返回 MARKET_UNAVAILABLE，不生成 mock 帖子。
MARKET_PROVIDER=disabled

# 学期课程列表（服务端代理 /api/term-courses）
# 本地开发可写入 Git 忽略的 .env.local；部署时使用服务端环境变量。
# 不要提交真实 JWT，也不要把该变量改成 VITE_ 前缀。
WECAMPUS_TOKEN=

# AI 课表截图识别（服务端代理 /api/schedule/recognize）
# 仅服务端读取，绝不下发浏览器；不要改成 VITE_ 前缀。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# 到梦空间活动模块：已部署 dream-monitor 的同源网页 API 地址（开发期 Vite 代理目标）
# 精确代理路径：/api/me /api/login /api/logout /api/state /api/refresh /api/activity
# 未部署该服务时保持默认值即可，前端会显示“未接入”，不会伪造数据。
DREAM_MONITOR_TARGET=http://127.0.0.1:8770

# ---------------------------------------------------------------------------
# 校园 AI 助手（智启云聚智能体 chat_query_v2）
# ---------------------------------------------------------------------------
# 服务端凭据（最小代理 /api/agent/* 使用，不下发浏览器）
AGENT_TRANSPORT=direct
AGENT_ORIGIN=https://agent.ynu.edu.cn
AGENT_APP_ID=
AGENT_API_KEY=
# 1-20 字符；留空则由每个浏览器本地生成并持久化，不会共享同一账号
AGENT_USER_ID=
AGENT_TIMEOUT_MS=120000
AGENT_CONFIG_TIMEOUT_MS=15000

# 浏览器直连（Vite 只注入 VITE_ 前缀变量）
# 警告：VITE_ 变量会被打包进前端资源，页面源码和开发者工具均可读取 AppID/Apikey。
# 仅用于用户明确接受的封闭演示环境；公开部署请改用 proxy 模式。
VITE_AGENT_TRANSPORT=direct
VITE_AGENT_ORIGIN=https://agent.ynu.edu.cn
VITE_AGENT_APP_ID=
VITE_AGENT_API_KEY=
VITE_AGENT_USER_ID=
VITE_AGENT_TIMEOUT_MS=120000
VITE_AGENT_CONFIG_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# 教师 / 课程查询（Node 代理：npm run api:courses → /api/courses）
# ---------------------------------------------------------------------------
# 教务会话只在服务端注入，绝不可加 VITE_ 前缀，也不要提交到仓库。
# 历史文档里的 Cookie 不是长期有效认证；失效时代理返回 EHALL_SESSION_EXPIRED。
EHALL_BASE_URL=https://ehall.ynu.edu.cn
EHALL_COOKIE=
EHALL_REFERER=
EHALL_TIMEOUT_MS=10000
# 本机需要经代理访问上游时填写（例如 http://127.0.0.1:54332），留空则直连。
EHALL_PROXY=
# 课程代理端口，需与 Vite 的 /api 代理目标保持一致。
COURSE_API_PORT=8787
