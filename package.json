{
  "name": "zhihe-yunqi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智启云聚：云南大学校园信息与智能服务平台",
  "scripts": {
    "dev": "vite",
    "dev:market": "vite --config src/dev/vite.market.config.js",
    "dev:server": "python server/app.py",
    "dev:dream-monitor": "python scripts/dream-monitor.py",
    "api:agent": "node server/dev-server.mjs",
    "api:courses": "node server/index.js",
    "test:gateway": "node --test tests/gateway.test.mjs",
    "test:courses": "node --test tests/course-utils.test.js tests/courses-route.test.js tests/teacher-course-api.test.js",
    "test:ai": "node --test tests/frontend-config.test.mjs tests/parse.test.mjs tests/markdown.test.mjs tests/sse.test.mjs tests/user-id.test.mjs tests/api-client.test.mjs tests/agent-api.test.mjs tests/stream.test.mjs tests/server.test.mjs",
    "test:course-grades": "node --test tests/course-grades.test.mjs",
    "test:dreamspace": "node --test tests/dreamspace-api.test.mjs tests/dreamspace-logic.test.mjs",
    "test:dream-backend": "python vendor/dream-monitor/test_patch.py",
    "test:market": "node --test tests/helpers.test.mjs && python -m unittest server.tests.test_api -v",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "dependencies": {
    "undici": "^8.12.3"
  }
}
